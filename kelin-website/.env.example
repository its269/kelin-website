# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Supabase Postgres pooler (server-only)
# Prefer DATABASE_URL (URL-encode $ as %24) so Next.js does not mangle passwords
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

ADMIN_JWT_SECRET=
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
INQUIRY_NOTIFY_EMAIL=
NEXT_PUBLIC_SITE_URL=https://www.kelingraphics.com

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
